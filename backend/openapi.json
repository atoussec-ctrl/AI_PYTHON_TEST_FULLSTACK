{
  "components": {
    "schemas": {
      "Attachment": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "document",
              "image",
              "audio"
            ],
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "mime_type",
          "size",
          "kind",
          "url",
          "created_at"
        ],
        "type": "object"
      },
      "Book": {
        "properties": {
          "author": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "publication_date": {
            "format": "date",
            "type": "string"
          },
          "publication_year": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "author",
          "publication_date",
          "publication_year",
          "summary",
          "created_at"
        ],
        "type": "object"
      },
      "ChatMessage": {
        "properties": {
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/Attachment"
            },
            "type": "array"
          },
          "content": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant",
              "system"
            ],
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "streaming",
              "completed",
              "failed"
            ],
            "type": "string"
          },
          "thinking_mode": {
            "enum": [
              "fast",
              "balanced",
              "deep"
            ],
            "nullable": true,
            "type": "string"
          },
          "trace_id": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "session_id",
          "role",
          "content",
          "thinking_mode",
          "status",
          "trace_id",
          "attachments",
          "created_at"
        ],
        "type": "object"
      },
      "ChatSession": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "pinned_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "pinned",
          "pinned_at",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "CreateBookRequest": {
        "properties": {
          "author": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "publication_date": {
            "format": "date",
            "type": "string"
          },
          "publication_year": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "author",
          "summary"
        ],
        "type": "object"
      },
      "CreateChatSessionRequest": {
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "details": {
                "additionalProperties": true,
                "type": "object"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "type": "object"
          },
          "request_id": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "type": "object"
      },
      "FeedbackRequest": {
        "properties": {
          "comment": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "score": {
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          }
        },
        "required": [
          "score"
        ],
        "type": "object"
      },
      "FeedbackResponse": {
        "properties": {
          "feedback_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "recorded": {
            "type": "boolean"
          }
        },
        "required": [
          "recorded"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "request_id": {
            "nullable": true,
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "request_id"
        ],
        "type": "object"
      },
      "ImportBookResponse": {
        "properties": {
          "book": {
            "$ref": "#/components/schemas/Book"
          },
          "extracted": {
            "properties": {
              "author": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "publication_year": {
                "type": "integer"
              },
              "summary": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "category",
              "author",
              "publication_year",
              "summary"
            ],
            "type": "object"
          }
        },
        "required": [
          "book",
          "extracted"
        ],
        "type": "object"
      },
      "SemanticSearchRequest": {
        "properties": {
          "k": {
            "type": "integer"
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "SemanticSearchResponse": {
        "properties": {
          "results": {
            "items": {
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "document_id",
                "title",
                "score",
                "excerpt"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "type": "object"
      },
      "SendMessageRequest": {
        "properties": {
          "attachment_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "content": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "thinking_mode": {
            "enum": [
              "fast",
              "balanced",
              "deep"
            ],
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "type": "object"
      },
      "SendMessageResponse": {
        "properties": {
          "assistant_message": {
            "$ref": "#/components/schemas/ChatMessage"
          },
          "assistant_message_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "user_message_id": {
            "type": "string"
          }
        },
        "required": [
          "user_message_id",
          "assistant_message_id",
          "status",
          "assistant_message"
        ],
        "type": "object"
      },
      "UpdateChatSessionRequest": {
        "properties": {
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [
          "pinned"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "Shared API_KEY configured by the operator. Optional only when the backend runs locally with API_KEY unset.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Flask API for the backend AI challenge: virtual library, Python assistant, LangSmith feedback, uploads and semantic search.",
    "title": "MindSight AI API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/attachments": {
      "post": {
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "description": "Allowlisted document, image or audio. The server validates size, name, MIME and signature/content before moving it out of quarantine.",
                    "format": "binary",
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "document",
                      "image",
                      "audio"
                    ],
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "session_id",
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attachment"
                }
              }
            },
            "description": "JSON response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Upload an attachment",
        "tags": [
          "Attachments"
        ]
      }
    },
    "/api/v1/attachments/{attachment_id}": {
      "delete": {
        "description": "Cleanup for the upload-then-send flow: removes an attachment still awaiting a message. Rejects attachments already attached to a message — use this only to compensate a failed send.",
        "parameters": [
          {
            "description": "Attachment id",
            "in": "path",
            "name": "attachment_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Attachment deleted"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Delete an attachment that was never linked to a message",
        "tags": [
          "Attachments"
        ]
      },
      "get": {
        "parameters": [
          {
            "description": "Attachment id",
            "in": "path",
            "name": "attachment_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attachment bytes"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Download an attachment",
        "tags": [
          "Attachments"
        ]
      }
    },
    "/api/v1/books": {
      "get": {
        "parameters": [
          {
            "description": "Filter by title",
            "in": "query",
            "name": "title",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by author",
            "in": "query",
            "name": "author",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by category",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Search title, author, category and summary",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Max items to return (1-200). Omit for the full unbounded list.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Items to skip before collecting results. Omit to start at 0.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  },
                  "type": "array"
                }
              }
            },
            "description": "JSON array response"
          }
        },
        "summary": "Search books",
        "tags": [
          "Books"
        ]
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            },
            "description": "JSON response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Create a book",
        "tags": [
          "Books"
        ]
      }
    },
    "/api/v1/books/import": {
      "post": {
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "description": ".txt, .md, .json or .pdf containing title, author, category, year and summary. Content and declared MIME are validated; PDFs are subject to configured resource limits.",
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportBookResponse"
                }
              }
            },
            "description": "JSON response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Import a book from uploaded file",
        "tags": [
          "Books"
        ]
      }
    },
    "/api/v1/books/{book_id}": {
      "get": {
        "parameters": [
          {
            "description": "Book id",
            "in": "path",
            "name": "book_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            },
            "description": "JSON response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Get a book by id",
        "tags": [
          "Books"
        ]
      }
    },
    "/api/v1/chat/messages": {
      "post": {
        "description": "Rate limited (RATE_LIMIT_CHAT_MESSAGES, default 20/min per IP).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "attachment_kinds": {
                    "items": {
                      "enum": [
                        "document",
                        "image",
                        "audio"
                      ],
                      "type": "string"
                    },
                    "maxItems": 5,
                    "type": "array"
                  },
                  "content": {
                    "type": "string"
                  },
                  "files": {
                    "description": "Files validated and linked to the user message within the same unit of work.",
                    "items": {
                      "format": "binary",
                      "type": "string"
                    },
                    "maxItems": 5,
                    "type": "array"
                  },
                  "model": {
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "thinking_mode": {
                    "enum": [
                      "fast",
                      "balanced",
                      "deep"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "session_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            },
            "description": "JSON response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Send a user message and create an assistant answer",
        "tags": [
          "Chat"
        ]
      }
    },
    "/api/v1/chat/messages/{assistant_message_id}/feedback": {
      "post": {
        "parameters": [
          {
            "description": "Assistant message id",
            "in": "path",
            "name": "assistant_message_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            },
            "description": "JSON response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Record LangSmith feedback for an assistant message",
        "tags": [
          "Chat"
        ]
      }
    },
    "/api/v1/chat/messages/{assistant_message_id}/stream": {
      "get": {
        "parameters": [
          {
            "description": "Assistant message id",
            "in": "path",
            "name": "assistant_message_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "SSE token stream"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Stream assistant message via Server-Sent Events",
        "tags": [
          "Chat"
        ]
      }
    },
    "/api/v1/chat/sessions": {
      "get": {
        "parameters": [
          {
            "description": "Max items to return (1-200). Omit for the full unbounded list.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Items to skip before collecting results. Omit to start at 0.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChatSession"
                  },
                  "type": "array"
                }
              }
            },
            "description": "JSON array response"
          }
        },
        "summary": "List chat sessions",
        "tags": [
          "Chat"
        ]
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChatSessionRequest"
              }
            }
          },
          "required": false
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSession"
                }
              }
            },
            "description": "JSON response"
          }
        },
        "summary": "Create chat session",
        "tags": [
          "Chat"
        ]
      }
    },
    "/api/v1/chat/sessions/{session_id}": {
      "delete": {
